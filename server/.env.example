# Copy this file to .env and adjust values.

# Postgres connection (matches docker-compose.yml)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/enikk_vendya?schema=public"

# API server
PORT=4000

# JWT secret for staff authentication — change this in production!
JWT_SECRET="change-this-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# Public base URL of the CUSTOMER app (used when generating QR codes / bill links)
CLIENT_URL="http://localhost:5173"

# CORS allowed origin (frontend). Use "*" only for quick local testing.
CORS_ORIGIN="http://localhost:5173"

# Shared secret used to validate incoming delivery-platform webhooks
PLATFORM_WEBHOOK_SECRET="change-this-platform-secret"
