# Copy this file to .env and adjust values.

# Set to "production" on your live server. In production the API refuses to
# boot unless JWT_SECRET and INTEGRATION_ENC_KEY are set.
NODE_ENV="development"

# Postgres connection (matches docker-compose.yml)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/enikk_vendya?schema=public"

# API server
PORT=4000

# Allow the demo "Simulate Partner Orders" endpoint in production (default off).
ALLOW_SIMULATE="0"

# JWT secret for staff authentication — change this in production!
JWT_SECRET="change-this-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# Public base URL of the CUSTOMER app (used when generating QR codes / bill links)
CLIENT_URL="http://localhost:5173"

# CORS allowed origin (frontend). Use "*" only for quick local testing.
CORS_ORIGIN="http://localhost:5173"

# Fallback shared secret for delivery-platform webhooks (per-platform secrets
# set in Admin → Settings → Delivery Partners take precedence over this).
PLATFORM_WEBHOOK_SECRET="change-this-platform-secret"

# Encryption key for delivery-partner API keys / secrets stored at rest.
# Use a long random value and keep it STABLE (changing it makes stored
# secrets unreadable and they must be re-entered).
INTEGRATION_ENC_KEY="change-this-to-a-long-random-encryption-key"

# Public base URL of THIS API (used to show each platform's webhook URL).
# Leave unset to derive it from the incoming request.
PUBLIC_URL=""
